# Plantilla de variables de entorno. Copiar a .env y completar.

# Base de datos. Local: base `proges_dev` en el Postgres del Mac (crearla con
# `createdb proges_dev` y `npx prisma migrate deploy`). Producción: URL de Neon.
DATABASE_URL="postgresql://<tu-usuario-del-mac>@localhost:5432/proges_dev?schema=public"

# Clerk (auth). Llaves desde dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
