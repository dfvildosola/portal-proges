{
  "name": "@proges/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "La base de Proges: esquema, migraciones, cliente de Prisma y scripts de carga.",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts"
  },
  "scripts": {
