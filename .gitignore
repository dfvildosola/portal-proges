# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# (en cualquier carpeta: cada workspace puede tener el suyo, como apps/api/node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.ejemplo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/packages/db/src/generated/prisma

# Datos reales para el guion de ejemplo (direcciones y ROL): nunca a GitHub, el repo es público
/packages/db/scripts/datos-reales.json
