// Proges — schema del núcleo (Fase 1).
// Modelo de gestión de patrimonio inmobiliario. Ver PLAN.md §2.
//
// Convenciones:
// - Toda tabla de negocio lleva `organizationId`: el id del cliente dueño de esos datos.
// - Montos y porcentajes en Decimal (precisión exacta; nunca float para dinero).
// - Multimoneda: cada monto guarda su `moneda` (CLP/UF); se convierte en lectura.
// - Archivos nunca en la DB: Document guarda metadatos + `blobKey` (binario en Blob).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum PropertyType {
  DEPARTAMENTO
  CASA
  OFICINA
  LOCAL
  BODEGA
  ESTACIONAMIENTO
  TERRENO
  PARCELA
  AGRICOLA
}

enum PropertyStatus {
  ARRENDADA
  DISPONIBLE
  EN_VENTA
  USO_PROPIO
  DESOCUPADA
}

enum PropertyGoal {
  INVERSION
  USO_PROPIO
  VENTA
}

enum Currency {
  CLP
  UF
}

enum OwnerType {
  PERSONA
  SOCIEDAD
}

enum PropertyUnitType {
  ESTACIONAMIENTO
  BODEGA
}

enum AdjustmentType {
  NINGUNO
  IPC
  UF
}

enum ChargeStatus {
  PENDIENTE
  PAGADO
  ATRASADO
}

enum MovementType {
  INGRESO
  GASTO
}

enum MovementCategory {
  ARRIENDO
  REPARACION
  GASTO_COMUN
  SEGURO
  IMPUESTO
  OTRO
}

enum TaxStatus {
  PENDIENTE
  PAGADA
}

enum BillType {
  GASTO_COMUN
  LUZ
  AGUA
  GAS
  OTRO
}

enum BillStatus {
  PENDIENTE
  PAGADA
}

enum DocumentType {
  ESCRITURA_TITULO
  CONTRATO
  AVALUO_TASACION
  LEGAL_JUDICIAL
  MUNICIPAL
  SEGURO
  MANTENCION
  CONTRIBUCION
  OTRO
}

// El papel concreto que es un documento (dominio vigente, recepción final…).
// El cajón donde se archiva sigue en Document.tipo.
enum Papel {
  ESCRITURA
  DOMINIO_VIGENTE
  HIPOTECAS_GRAVAMENES
  CERTIFICADO_AVALUO
  PLANO
  CIP
  RECEPCION_FINAL
  POLIZA_SEGURO
  PERMISO_EDIFICACION
  CERTIFICADO_NUMERO
  REGLAMENTO_COPROPIEDAD
  SUBDIVISION_SAG
  DERECHOS_AGUA
  CONTRATO_ARRIENDO
}

enum RateType {
  UF
  IPC
}

// Fuente del valor comercial de una propiedad. «Estimación automática» se
// agrega cuando exista.
enum ValorFuente {
  TASACION
  CORREDOR
  ESTIMACION_PROPIA
}

// ----------------------------------------------------------------------------
// Propiedades
// ----------------------------------------------------------------------------

model Property {
  id                   String         @id @default(cuid())
  organizationId       String
  // El ROL es opcional: el inventario del Drive no lo trae.
  rolSII               String?
  tipo                 PropertyType
  direccion            String
  comuna               String
  region               String
  objetivo             PropertyGoal   @default(INVERSION)
  estado               PropertyStatus @default(DISPONIBLE)
  monedaPrincipal      Currency       @default(CLP)
  m2Terreno            Decimal?       @db.Decimal(10, 2)
  m2Construidos        Decimal?       @db.Decimal(10, 2)
  anoConstruccion      Int?
  valorComercial       Decimal?       @db.Decimal(14, 2)
  valorComercialMoneda Currency       @default(CLP)
  // Fecha y fuente del valor comercial (para saber qué tan al día está).
  valorComercialFecha  DateTime?
  valorComercialFuente ValorFuente?
  // Compra: cuándo y por cuánto se compró.
  compraFecha          DateTime?
  compraPrecio         Decimal?       @db.Decimal(14, 2)
  compraMoneda         Currency       @default(CLP)
  // Deuda hipotecaria vigente (todo vacío si no hay deuda). El dividendo va en
  // la misma moneda que el saldo.
  deudaSaldo           Decimal?       @db.Decimal(14, 2)
  deudaMoneda          Currency       @default(UF)
  deudaFecha           DateTime? // fecha a la que corresponde el saldo
  deudaBanco           String?
  deudaDividendo       Decimal?       @db.Decimal(14, 2)
  deudaTermino         DateTime? // fecha del último dividendo
  // Exenta de contribuciones: no paga cuotas (p. ej. bodegas de avalúo bajo).
  exentaContribuciones Boolean        @default(false)
  // Id de la carpeta de esta propiedad en Google Drive (para abrirla desde la ficha).
  driveCarpetaId       String?
  // El edificio es solo un texto que agrupa unidades («Monjitas 550»): la unidad es la propiedad.
  edificio             String?
  // Código de la cuenta analítica de Odoo de esta unidad. Puede repetirse entre propiedades
  // (una cuenta puede cubrir dos deptos): sirve para sugerir la unidad al enlazar una orden.
  odooCuentaAnalitica  String?
  // Quién guardó por última vez (el equipo y el dueño editan lo mismo: vale el último).
  modificadoPorId      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  modificadoPor Usuario? @relation("PropertyModificadoPor", fields: [modificadoPorId], references: [id], onDelete: SetNull)

  owners           PropertyOwner[]
  tags             PropertyTag[]        @relation("PropertyToTag")
  units            PropertyUnit[]
  assessments      PropertyAssessment[]
  documents        Document[]
  contracts        LeaseContract[]
  movements        Movement[]
  taxes            PropertyTax[]
  bills            PropertyBill[]
  servicios        ServicioEnCurso[]
  solicitudes      Solicitud[]
  administraciones Administracion[]

  @@index([organizationId])
}

// Anexo de una propiedad: estacionamiento o bodega. En Chile suelen tener su
// propio ROL y avalúo (para contribuciones), pero se administran junto a la
// unidad principal. ROL y avalúo son opcionales.
model PropertyUnit {
  id             String           @id @default(cuid())
  organizationId String
  propertyId     String
  tipo           PropertyUnitType
  numero         String
  rolSII         String?
  avaluoFiscal   Decimal?         @db.Decimal(14, 2)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
}

// Historial de avalúos fiscales de la propiedad (uno por año).
// Se usa para calcular el % de reajuste entre períodos.
model PropertyAssessment {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  anio           Int
  valor          Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, anio])
  @@index([organizationId])
  @@index([propertyId])
}

model PropertyTag {
  id             String     @id @default(cuid())
  organizationId String
  nombre         String
  properties     Property[] @relation("PropertyToTag")

  @@unique([organizationId, nombre])
  @@index([organizationId])
}

// Grupo económico / controlador: el "dueño real" (familia o persona) que controla
// varias entidades legales (personas y sociedades). Permite consolidar el
// patrimonio de todas sus entidades en los informes. Opcional: una entidad puede
// no pertenecer a ningún grupo.
model Grupo {
  id             String   @id @default(cuid())
  organizationId String
  nombre         String
  rut            String? // RUT del controlador/persona, opcional
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owners Owner[]

  @@index([organizationId])
}

// Entidad legal dueña de propiedades: persona natural o sociedad. Reutilizable
// entre propiedades (una misma entidad participa en varias vía PropertyOwner).
model Owner {
  id             String          @id @default(cuid())
  organizationId String
  nombre         String
  rut            String
  tipo           OwnerType       @default(PERSONA)
  grupoId        String?
  grupo          Grupo?          @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  properties     PropertyOwner[]

  @@index([organizationId])
  @@index([grupoId])
}

// Puente de copropiedad: varios dueños por propiedad, cada uno con su %.
model PropertyOwner {
  id             String  @id @default(cuid())
  organizationId String
  propertyId     String
  ownerId        String
  porcentaje     Decimal @db.Decimal(5, 2)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerId])
  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// Contratos de arriendo
// ----------------------------------------------------------------------------

model Tenant {
  id             String          @id @default(cuid())
  organizationId String
  nombre         String
  rut            String
  email          String?
  telefono       String?
  contracts      LeaseContract[]

  @@index([organizationId])
}

model LeaseContract {
  id                      String         @id @default(cuid())
  organizationId          String
  propertyId              String
  tenantId                String
  monto                   Decimal        @db.Decimal(14, 2)
  moneda                  Currency       @default(CLP)
  aplicaReajuste          Boolean        @default(false)
  reajusteTipo            AdjustmentType @default(NINGUNO)
  reajusteFrecuenciaMeses Int?
  fechaInicio             DateTime
  fechaTermino            DateTime
  diaPago                 Int
  renovacionAutomatica    Boolean        @default(true) // se renueva sola por el mismo plazo salvo aviso
  diasAviso               Int            @default(60) // días antes del término para avisar que no se renueva
  plazoMeses              Int // duración de cada período (y de cada renovación), en meses
  fechaSalida             DateTime? // si hay, el contrato termina ese día y no se renueva
  garantia                Decimal?       @db.Decimal(14, 2) // garantía, en la moneda del arriendo
  ultimoReajuste          DateTime? // fecha del último reajuste aplicado
  modificadoPorId         String? // quién guardó por última vez
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  modificadoPor Usuario?     @relation("ContratoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: SetNull)
  charges       RentCharge[]

  @@index([organizationId])
  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Control económico
// ----------------------------------------------------------------------------

// Cobro de arriendo por período. El corazón de la cobranza.
model RentCharge {
  id               String       @id @default(cuid())
  organizationId   String
  contractId       String
  periodo          String // "YYYY-MM"
  montoEsperado    Decimal      @db.Decimal(14, 2)
  moneda           Currency     @default(CLP)
  fechaVencimiento DateTime
  estado           ChargeStatus @default(PENDIENTE)
  fechaPago        DateTime?
  montoPagado      Decimal?     @db.Decimal(14, 2)
  interesMora      Decimal?     @db.Decimal(14, 2) // manual en MVP
  notas            String?
  modificadoPorId  String? // quién lo marcó pagado o lo cambió por última vez

  contract      LeaseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  modificadoPor Usuario?      @relation("CobroModificadoPor", fields: [modificadoPorId], references: [id], onDelete: SetNull)
  movements     Movement[]

  @@unique([contractId, periodo])
  @@index([organizationId])
}

model Movement {
  id             String           @id @default(cuid())
  organizationId String
  propertyId     String
  tipo           MovementType
  categoria      MovementCategory
  monto          Decimal          @db.Decimal(14, 2)
  moneda         Currency         @default(CLP)
  fecha          DateTime
  descripcion    String?
  documentId     String?
  rentChargeId   String?

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  document   Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  rentCharge RentCharge? @relation(fields: [rentChargeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
}

model PropertyTax {
  id               String    @id @default(cuid())
  organizationId   String
  propertyId       String
  anio             Int
  cuota            Int // 1-4
  monto            Decimal?  @db.Decimal(14, 2)
  fechaVencimiento DateTime
  estado           TaxStatus @default(PENDIENTE)
  fechaPago        DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, anio, cuota])
  @@index([organizationId])
}

// Cuenta que el dueño debe pagar por una propiedad (gasto común, luz, agua,
// gas, otro). Las contribuciones siguen aparte en PropertyTax.
model PropertyBill {
  id               String     @id @default(cuid())
  organizationId   String
  propertyId       String
  tipo             BillType
  periodo          String // "YYYY-MM"
  monto            Decimal?   @db.Decimal(14, 2)
  moneda           Currency   @default(CLP)
  fechaVencimiento DateTime
  estado           BillStatus @default(PENDIENTE)
  fechaPago        DateTime?
  notas            String?
  createdAt        DateTime   @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Documental
// ----------------------------------------------------------------------------

// Metadatos + puntero al archivo. El binario vive en Vercel Blob (privado).
// `extractedText`/embeddings (silver/gold) son post-MVP — reservados, no se llenan aún.
model Document {
  id               String       @id @default(cuid())
  organizationId   String
  propertyId       String
  tipo             DocumentType
  papel            Papel? // qué papel es (null = documento suelto, sin papel asignado)
  nombre           String
  blobKey          String // puntero al objeto en Vercel Blob
  fechaEmision     DateTime?
  fechaVencimiento DateTime? // alimenta alertas de vencimiento
  // Campos Conservador (opcionales)
  fojas            String?
  numero           String?
  anio             Int?
  // Reservado para IA (post-MVP): texto extraído del PDF/imagen
  extractedText    String?
  createdAt        DateTime     @default(now())

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  movements Movement[]

  @@index([organizationId])
  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Soporte
// ----------------------------------------------------------------------------

// Valores UF/IPC para convertir entre CLP y UF en informes. Global (sin organizationId).
model CurrencyValue {
  id    String   @id @default(cuid())
  fecha DateTime
  tipo  RateType
  valor Decimal  @db.Decimal(14, 4)

  @@unique([fecha, tipo])
}

// ----------------------------------------------------------------------------
// Etapa 1: dos caras (equipo Proges + cliente) y servicios en curso
// ----------------------------------------------------------------------------

enum UsuarioRol {
  EQUIPO
  CLIENTE
}

// Un espacio es de Proges (catálogo y etapas, comunes a todos) o de un cliente (su cartera).
enum OrganizacionTipo {
  PROGES
  CLIENTE
}

// Cómo va un pedido de servicio: llega NUEVA; el equipo la acepta (abre un servicio) o la rechaza.
enum SolicitudEstado {
  NUEVA
  ACEPTADA
  RECHAZADA
}

// Los seis tipos de servicio están fijos en el código; sus etapas son filas
// editables (modelo Etapa).
enum ServicioTipo {
  EVALUACION
  INSPECCION
  VENTA
  ARRIENDO
  OBRA
  ADMINISTRACION
}

enum ServicioEstado {
  ABIERTO
  TERMINADO
  CANCELADO
}

enum EventoTipo {
  ETAPA
  PRECIO
}

// Quién fijó un precio: el propietario, o lo sugirió Proges (por una evaluación).
enum PrecioOrigen {
  PROPIETARIO
  SUGERIDO_PROGES
}

enum OfertaEstado {
  RECIBIDA
  ACEPTADA
  RECHAZADA
  CAIDA
}

// Un espacio de trabajo. Cada cliente es uno (su cartera vive ahí) y Proges tiene el suyo
// (`org_proges`: el catálogo y las etapas, comunes a todos los clientes). Es la «carpeta» que
// todas las tablas de negocio nombran en su columna `organizationId`; esa columna es texto
// simple, sin relación con esta tabla, para no tocar las tablas que ya existían.
model Organizacion {
  id        String           @id
  nombre    String
  tipo      OrganizacionTipo
  activa    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Persona que entra al portal. El correo (en minúsculas) la une con Clerk.
// Rol EQUIPO (organizationId = org_proges) trabaja para Proges; rol CLIENTE
// (organizationId = su cliente) administra la cartera de su espacio.
model Usuario {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique // siempre en minúsculas
  nombre         String
  rol            UsuarioRol
  admin          Boolean    @default(false) // crea clientes y usuarios y edita etapas
  jefatura       Boolean    @default(false) // solo EQUIPO: aprueba presupuestos de maestros y cierra obras
  activo         Boolean    @default(true)
  ultimoIngreso  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  responsable          ServicioEnCurso[]
  eventos              Evento[]
  visitas              Visita[]
  solicitudesPedidas   Solicitud[]       @relation("SolicitudPedidaPor")
  solicitudesResueltas Solicitud[]       @relation("SolicitudResueltaPor")

  propiedadesModificadas Property[]           @relation("PropertyModificadoPor")
  contratosModificados   LeaseContract[]      @relation("ContratoModificadoPor")
  cobrosModificados      RentCharge[]         @relation("CobroModificadoPor")
  tareasResponsable      Tarea[]              @relation("TareaResponsable")
  tareasHechas           Tarea[]              @relation("TareaHechaPor")
  tareasCreadas          Tarea[]              @relation("TareaCreadaPor")
  notas                  Nota[]
  partidasRecibidas      Partida[]
  presupuestosCargados   PresupuestoMaestro[] @relation("PresupuestoCargadoPor")
  presupuestosResueltos  PresupuestoMaestro[] @relation("PresupuestoResueltoPor")
  facturasAsignadas      FacturaMaestro[]

  @@index([organizationId])
}

// Un paso del recorrido de un tipo de servicio. Se edita en el portal.
// Las dos marcas hacen que los indicadores no dependan del nombre de la etapa.
model Etapa {
  id                 String       @id @default(cuid())
  organizationId     String
  tipo               ServicioTipo
  nombre             String
  orden              Int
  cierraServicio     Boolean      @default(false) // llegar acá termina el servicio
  propiedadPublicada Boolean      @default(false) // mientras está acá, la propiedad está publicada
  activa             Boolean      @default(true) // una etapa con servicios adentro no se borra: se desactiva
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  servicios ServicioEnCurso[]
  eventos   Evento[]

  @@index([organizationId, tipo])
}

// El catálogo de servicios (viene de la Sheet / Odoo). El código solo NO es
// único: la fuente trae tres códigos repetidos con nombres distintos.
model Servicio {
  id             String  @id @default(cuid())
  organizationId String
  codigo         String
  familia        String // prefijo del código antes del guion (NV, RR, ADMP…)
  nombre         String
  unidad         String?
  activo         Boolean @default(true)

  enCurso ServicioEnCurso[]

  @@unique([organizationId, codigo, nombre])
  @@index([organizationId])
}

// La unidad de trabajo: un servicio que se está prestando sobre una propiedad.
// Una propiedad puede tener varios a la vez; cada uno avanza por las etapas de su tipo.
model ServicioEnCurso {
  id             String         @id @default(cuid())
  organizationId String
  propertyId     String
  servicioId     String
  tipo           ServicioTipo
  etapaId        String
  responsableId  String?
  estado         ServicioEstado @default(ABIERTO)
  motivoCierre   String? // al cancelar o terminar
  porConfirmar   Boolean        @default(false) // deducido de la carga inicial, falta que el equipo lo confirme
  nota           String?
  abiertoEl      DateTime       @default(now())
  cerradoEl      DateTime?

  // Solo para VENTA y ARRIENDO.
  precio             Decimal?  @db.Decimal(14, 2)
  precioMoneda       Currency?
  avisoUrl           String? // enlace del aviso publicado (Nexxos solo publica)
  recomendacion      String?
  recomendacionFecha DateTime?

  // Nace de un pedido del cliente y la jefatura todavía no lo revisó ni lo repartió.
  porRevisar        Boolean   @default(false)
  // Solo para OBRA (fechas civiles, medianoche UTC): cuándo empezó el trabajo y cuándo se
  // le prometió al dueño que terminaba.
  inicioObra        DateTime?
  fechaComprometida DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property        Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  servicio        Servicio             @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  etapa           Etapa                @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  responsable     Usuario?             @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  eventos         Evento[]
  visitas         Visita[]
  ofertas         Oferta[]
  solicitud       Solicitud? // el pedido del cliente que abrió este servicio, si lo hubo
  tareas          Tarea[]
  notas           Nota[]
  orden           OrdenDueno? // la orden de venta de Odoo enlazada, si ya existe
  partidas        Partida[]
  presupuestos    PresupuestoMaestro[]
  facturasMaestro FacturaMaestro[]

  @@index([propertyId])
  @@index([organizationId, estado])
}

// Historial de un servicio: cada cambio de etapa o de precio deja una fila.
model Evento {
  id                String        @id @default(cuid())
  organizationId    String
  servicioEnCursoId String
  tipo              EventoTipo
  etapaId           String? // solo en ETAPA: la etapa a la que entró
  anterior          String?
  nuevo             String // ETAPA: nombre de la etapa tal como era ese día; PRECIO: el monto como texto
  moneda            Currency?
  origen            PrecioOrigen? // solo en PRECIO
  motivo            String?
  autorId           String?
  fecha             DateTime      @default(now())

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  etapa           Etapa?          @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  autor           Usuario?        @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([servicioEnCursoId])
}

model Visita {
  id                 String   @id @default(cuid())
  organizationId     String
  servicioEnCursoId  String
  fecha              DateTime
  realizadaPorId     String?
  interesadoNombre   String? // el cliente no ve los datos del interesado
  interesadoContacto String?
  evaluacion         Int? // 1 a 5
  comentario         String?
  createdAt          DateTime @default(now())

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  realizadaPor    Usuario?        @relation(fields: [realizadaPorId], references: [id], onDelete: SetNull)

  @@index([servicioEnCursoId])
}

model Oferta {
  id                String       @id @default(cuid())
  organizationId    String
  servicioEnCursoId String
  fecha             DateTime
  monto             Decimal      @db.Decimal(14, 2)
  moneda            Currency
  oferente          String
  estado            OfertaEstado @default(RECIBIDA)
  nota              String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)

  @@index([servicioEnCursoId])
}

// Un pedido de servicio de un cliente sobre una de sus propiedades. Llega NUEVA; el equipo
// la acepta (abre el servicio y queda enlazado en `servicioEnCursoId`) o la rechaza con motivo.
// No lleva precio: se cotiza después, fuera del portal.
model Solicitud {
  id                String          @id @default(cuid())
  organizationId    String // el cliente que la pidió
  propertyId        String
  tipo              ServicioTipo
  descripcion       String // qué necesita, en texto libre
  pedidaPorId       String
  estado            SolicitudEstado @default(NUEVA)
  motivoRechazo     String?
  resueltaPorId     String?
  resueltaEl        DateTime?
  servicioEnCursoId String?         @unique
  createdAt         DateTime        @default(now())

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  pedidaPor       Usuario          @relation("SolicitudPedidaPor", fields: [pedidaPorId], references: [id], onDelete: Restrict)
  resueltaPor     Usuario?         @relation("SolicitudResueltaPor", fields: [resueltaPorId], references: [id], onDelete: SetNull)
  servicioEnCurso ServicioEnCurso? @relation(fields: [servicioEnCursoId], references: [id], onDelete: SetNull)

  @@index([organizationId, estado])
  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Etapa 1 (v6): trabajo del equipo, bitácora, obra con maestros y administración
// ----------------------------------------------------------------------------

enum RecepcionPartida {
  PENDIENTE
  CONFORME
  OBSERVADA
}

enum PresupuestoTipo {
  ORIGINAL
  ADICIONAL
}

enum PresupuestoEstado {
  RECIBIDO
  APROBADO
  RECHAZADO
}

// Lo que alguien tiene que hacer en un proyecto: qué, quién y para cuándo. Sin estados
// intermedios: o está abierta o está hecha (`hechaEl`).
model Tarea {
  id                String    @id @default(cuid())
  organizationId    String
  servicioEnCursoId String
  que               String
  responsableId     String?
  vence             DateTime? // fecha civil (medianoche UTC)
  hechaEl           DateTime?
  hechaPorId        String?
  creadaPorId       String
  // Si la abrió una recepción observada: la partida que hay que corregir.
  partidaId         String?
  // true en la tarea «Revisar y repartir» que abre un pedido del cliente: así se la reconoce
  // sin depender de cómo empiece su texto (que cualquiera puede escribir igual a mano).
  esRevision        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  responsable     Usuario?        @relation("TareaResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  hechaPor        Usuario?        @relation("TareaHechaPor", fields: [hechaPorId], references: [id], onDelete: SetNull)
  creadaPor       Usuario         @relation("TareaCreadaPor", fields: [creadaPorId], references: [id], onDelete: Restrict)
  partida         Partida?        @relation(fields: [partidaId], references: [id], onDelete: SetNull)
  notas           Nota[]

  @@index([organizationId])
  @@index([servicioEnCursoId])
  @@index([responsableId, hechaEl])
}

// La bitácora del proyecto: lo que pasa, anotado en el momento. `paraDueno` marca las
// notas (y sus fotos) que el dueño puede ver; las demás son solo del equipo.
model Nota {
  id                String   @id @default(cuid())
  organizationId    String
  servicioEnCursoId String
  autorId           String
  texto             String
  paraDueno         Boolean  @default(false)
  tareaId           String?
  createdAt         DateTime @default(now())

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  autor           Usuario         @relation(fields: [autorId], references: [id], onDelete: Restrict)
  tarea           Tarea?          @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  fotos           Foto[]

  @@index([organizationId])
  @@index([servicioEnCursoId, createdAt])
}

// Una foto guardada en el Drive de la propiedad (subcarpeta «Portal»). Solo se guarda su id
// de Drive: el archivo se ve a través de la ruta /archivos/[driveFileId], que revisa permisos.
// Cuelga de una nota (bitácora) o de una partida (recepción).
model Foto {
  id             String   @id @default(cuid())
  organizationId String
  notaId         String?
  partidaId      String?
  driveFileId    String   @unique
  nombre         String
  mime           String
  createdAt      DateTime @default(now())

  nota    Nota?    @relation(fields: [notaId], references: [id], onDelete: Cascade)
  partida Partida? @relation(fields: [partidaId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([notaId])
  @@index([partidaId])
}

// El maestro es un proveedor de Odoo (res.partner); acá solo se le suma lo que Odoo no
// tiene. Vive en el espacio de Proges y vale para todos los clientes.
model Maestro {
  id             String  @id @default(cuid())
  organizationId String // siempre org_proges
  odooPartnerId  Int     @unique
  nombre         String // copiado de Odoo al agregarlo
  especialidad   String?
  telefono       String?
  activo         Boolean @default(true)

  partidas     Partida[]
  presupuestos PresupuestoMaestro[]
  facturas     FacturaMaestro[]

  @@index([organizationId])
}

// La orden de venta de Odoo que el dueño aprobó (S00047). Se trae por su número; el portal
// nunca escribe en Odoo. `facturado` es lo que ya se le facturó al dueño (los anticipos).
model OrdenDueno {
  id                String   @id @default(cuid())
  organizationId    String
  servicioEnCursoId String   @unique
  numero            String // «S00047»
  odooOrderId       Int
  total             Decimal  @db.Decimal(14, 2) // sin impuesto
  moneda            Currency @default(CLP)
  facturado         Decimal  @default(0) @db.Decimal(14, 2)
  traidaEl          DateTime @default(now())

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  partidas        Partida[]

  @@index([organizationId])
}

// Una línea de trabajo: lo que hay que hacer (en una reparación, agrupada por recinto; en un
// servicio suelto, una lista para marcar). Se reconoce por `odooLineId` al volver a traer la
// orden: las nuevas se suman, las que Odoo ya no tiene se marcan `quitadaEnOdoo`, nunca se borran.
model Partida {
  id                String           @id @default(cuid())
  organizationId    String
  servicioEnCursoId String
  ordenId           String?
  recinto           String?
  codigo            String?
  descripcion       String
  cantidad          Decimal?         @db.Decimal(14, 3)
  unidad            String?
  precioDueno       Decimal?         @db.Decimal(14, 2)
  moneda            Currency         @default(CLP)
  odooLineId        Int?
  posicion          Int              @default(0)
  maestroId         String?
  avance            Int              @default(0) // 0 a 100
  recepcion         RecepcionPartida @default(PENDIENTE)
  observacion       String?
  recibidaEl        DateTime?
  recibidaPorId     String?
  quitadaEnOdoo     Boolean          @default(false)

  servicioEnCurso ServicioEnCurso      @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  orden           OrdenDueno?          @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  maestro         Maestro?             @relation(fields: [maestroId], references: [id], onDelete: SetNull)
  recibidaPor     Usuario?             @relation(fields: [recibidaPorId], references: [id], onDelete: SetNull)
  presupuestos    PresupuestoMaestro[] @relation("PresupuestoPartidas")
  fotos           Foto[]
  tareas          Tarea[]

  @@unique([ordenId, odooLineId])
  @@index([organizationId])
  @@index([servicioEnCursoId, posicion])
}

// El presupuesto que manda un maestro para un proyecto (pesos chilenos). Lo aprueba la
// jefatura; el aprobado es el plan de costo. Un adicional es un cambio de alcance y se aprueba igual.
model PresupuestoMaestro {
  id                String            @id @default(cuid())
  organizationId    String
  servicioEnCursoId String
  maestroId         String
  tipo              PresupuestoTipo   @default(ORIGINAL)
  total             Decimal           @db.Decimal(14, 2) // CLP
  plazoDias         Int?
  pdfDriveFileId    String?
  estado            PresupuestoEstado @default(RECIBIDO)
  nota              String?
  cargadoPorId      String
  resueltoPorId     String?
  resueltoEl        DateTime?
  createdAt         DateTime          @default(now())

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  maestro         Maestro         @relation(fields: [maestroId], references: [id], onDelete: Restrict)
  cargadoPor      Usuario         @relation("PresupuestoCargadoPor", fields: [cargadoPorId], references: [id], onDelete: Restrict)
  resueltoPor     Usuario?        @relation("PresupuestoResueltoPor", fields: [resueltoPorId], references: [id], onDelete: SetNull)
  partidas        Partida[]       @relation("PresupuestoPartidas")

  @@index([organizationId])
  @@index([servicioEnCursoId])
  @@index([pdfDriveFileId])
}

// Una factura del maestro asignada a un proyecto. Con `odooMoveId` solo se guarda la
// asignación: número, fecha, total, estado y pago se leen de Odoo al mirar. Sin él es una
// factura «fuera de Odoo» que el equipo anota a mano (número, fecha, si está pagada y nota).
// Una factura puede repartirse entre proyectos; la suma asignada nunca pasa su total.
model FacturaMaestro {
  id                String    @id @default(cuid())
  organizationId    String
  servicioEnCursoId String
  maestroId         String
  odooMoveId        Int?
  numero            String? // solo las anotadas a mano
  fecha             DateTime? // solo las anotadas a mano (fecha civil)
  pagada            Boolean   @default(false) // solo las anotadas a mano
  nota              String?
  montoAsignado     Decimal   @db.Decimal(14, 2) // CLP
  asignadaPorId     String
  createdAt         DateTime  @default(now())

  servicioEnCurso ServicioEnCurso @relation(fields: [servicioEnCursoId], references: [id], onDelete: Cascade)
  maestro         Maestro         @relation(fields: [maestroId], references: [id], onDelete: Restrict)
  asignadaPor     Usuario         @relation(fields: [asignadaPorId], references: [id], onDelete: Restrict)

  @@unique([servicioEnCursoId, odooMoveId])
  @@index([organizationId])
  @@index([odooMoveId])
}

// Una propiedad que Proges administra: el arrendatario le paga directo al dueño, Proges
// controla que pague y cobra su comisión (arriendo × %, calculada al mirar, no guardada).
model Administracion {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String
  desde          DateTime // fecha civil (medianoche UTC)
  hasta          DateTime? // vacío = sigue vigente
  comisionPct    Decimal   @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
}
