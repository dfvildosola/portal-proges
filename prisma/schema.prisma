// Proges — schema del núcleo (Fase 1).
// Modelo de gestión de patrimonio inmobiliario. Ver PLAN.md §2.
//
// Convenciones:
// - Toda tabla de negocio lleva `organizationId` (aislamiento futuro; hoy valor fijo).
// - Montos y porcentajes en Decimal (precisión exacta; nunca float para dinero).
// - Multimoneda: cada monto guarda su `moneda` (CLP/UF); se convierte en lectura.
// - Archivos nunca en la DB: Document guarda metadatos + `blobKey` (binario en Blob).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum PropertyType {
  DEPARTAMENTO
  CASA
  OFICINA
  LOCAL
  BODEGA
  ESTACIONAMIENTO
  TERRENO
  PARCELA
  AGRICOLA
}

enum PropertyStatus {
  ARRENDADA
  DISPONIBLE
  EN_VENTA
  USO_PROPIO
  DESOCUPADA
}

enum PropertyGoal {
  INVERSION
  USO_PROPIO
  VENTA
}

enum Currency {
  CLP
  UF
}

enum OwnerType {
  PERSONA
  SOCIEDAD
}

enum PropertyUnitType {
  ESTACIONAMIENTO
  BODEGA
}

enum ContractStatus {
  VIGENTE
  POR_VENCER
  VENCIDO
  RENOVADO
  TERMINADO
}

enum AdjustmentType {
  NINGUNO
  IPC
  UF
}

enum ChargeStatus {
  PENDIENTE
  PAGADO
  ATRASADO
}

enum MovementType {
  INGRESO
  GASTO
}

enum MovementCategory {
  ARRIENDO
  REPARACION
  GASTO_COMUN
  SEGURO
  IMPUESTO
  OTRO
}

enum TaxStatus {
  PENDIENTE
  PAGADA
}

enum BillType {
  GASTO_COMUN
  LUZ
  AGUA
  GAS
  OTRO
}

enum BillStatus {
  PENDIENTE
  PAGADA
}

enum DocumentType {
  ESCRITURA_TITULO
  CONTRATO
  AVALUO_TASACION
  LEGAL_JUDICIAL
  MUNICIPAL
  SEGURO
  MANTENCION
  CONTRIBUCION
  OTRO
}

// El papel concreto que es un documento (dominio vigente, recepción final…).
// El cajón donde se archiva sigue en Document.tipo.
enum Papel {
  ESCRITURA
  DOMINIO_VIGENTE
  HIPOTECAS_GRAVAMENES
  CERTIFICADO_AVALUO
  PLANO
  CIP
  RECEPCION_FINAL
  POLIZA_SEGURO
  PERMISO_EDIFICACION
  CERTIFICADO_NUMERO
  REGLAMENTO_COPROPIEDAD
  SUBDIVISION_SAG
  DERECHOS_AGUA
  CONTRATO_ARRIENDO
}

enum AlertType {
  ARRENDADA_SIN_CONTRATO
  CONTRATO_POR_VENCER
  ARRIENDO_ATRASADO
  CONTRIBUCION_IMPAGA
  CONTRIBUCION_POR_VENCER
  DESOCUPADA_PROLONGADA
  CUENTA_VENCIDA
  CUENTA_POR_VENCER
  COBROS_SIN_GENERAR
}

enum AlertSeverity {
  INFO
  MEDIA
  ALTA
}

enum AlertStatus {
  ACTIVA
  RESUELTA
}

enum RateType {
  UF
  IPC
}

// Fuente del valor comercial de una propiedad. «Estimación automática» se
// agrega cuando exista.
enum ValorFuente {
  TASACION
  CORREDOR
  ESTIMACION_PROPIA
}

// ----------------------------------------------------------------------------
// Propiedades
// ----------------------------------------------------------------------------

model Property {
  id             String         @id @default(cuid())
  organizationId String
  rolSII         String
  tipo           PropertyType
  direccion      String
  comuna         String
  region         String
  objetivo       PropertyGoal   @default(INVERSION)
  estado         PropertyStatus @default(DISPONIBLE)
  monedaPrincipal Currency      @default(CLP)
  m2Terreno      Decimal?       @db.Decimal(10, 2)
  m2Construidos  Decimal?       @db.Decimal(10, 2)
  anoConstruccion Int?
  valorComercial       Decimal?  @db.Decimal(14, 2)
  valorComercialMoneda Currency  @default(CLP)
  // Fecha y fuente del valor comercial (para saber qué tan al día está).
  valorComercialFecha  DateTime?
  valorComercialFuente ValorFuente?
  // Compra: cuándo y por cuánto se compró.
  compraFecha          DateTime?
  compraPrecio         Decimal?  @db.Decimal(14, 2)
  compraMoneda         Currency  @default(CLP)
  // Deuda hipotecaria vigente (todo vacío si no hay deuda). El dividendo va en
  // la misma moneda que el saldo.
  deudaSaldo           Decimal?  @db.Decimal(14, 2)
  deudaMoneda          Currency  @default(UF)
  deudaFecha           DateTime? // fecha a la que corresponde el saldo
  deudaBanco           String?
  deudaDividendo       Decimal?  @db.Decimal(14, 2)
  deudaTermino         DateTime? // fecha del último dividendo
  // Exenta de contribuciones: no paga cuotas (p. ej. bodegas de avalúo bajo).
  exentaContribuciones Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt      DateTime       @updatedAt

  owners      PropertyOwner[]
  tags        PropertyTag[]        @relation("PropertyToTag")
  units       PropertyUnit[]
  assessments PropertyAssessment[]
  documents Document[]
  contracts LeaseContract[]
  movements Movement[]
  taxes     PropertyTax[]
  bills     PropertyBill[]
  alerts    Alert[]

  @@index([organizationId])
}

// Anexo de una propiedad: estacionamiento o bodega. En Chile suelen tener su
// propio ROL y avalúo (para contribuciones), pero se administran junto a la
// unidad principal. ROL y avalúo son opcionales.
model PropertyUnit {
  id             String           @id @default(cuid())
  organizationId String
  propertyId     String
  tipo           PropertyUnitType
  numero         String
  rolSII         String?
  avaluoFiscal   Decimal?         @db.Decimal(14, 2)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
}

// Historial de avalúos fiscales de la propiedad (uno por año).
// Se usa para calcular el % de reajuste entre períodos.
model PropertyAssessment {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  anio           Int
  valor          Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, anio])
  @@index([organizationId])
  @@index([propertyId])
}

model PropertyTag {
  id             String     @id @default(cuid())
  organizationId String
  nombre         String
  properties     Property[] @relation("PropertyToTag")

  @@unique([organizationId, nombre])
  @@index([organizationId])
}

// Grupo económico / controlador: el "dueño real" (familia o persona) que controla
// varias entidades legales (personas y sociedades). Permite consolidar el
// patrimonio de todas sus entidades en los informes. Opcional: una entidad puede
// no pertenecer a ningún grupo.
model Grupo {
  id             String   @id @default(cuid())
  organizationId String
  nombre         String
  rut            String? // RUT del controlador/persona, opcional
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owners Owner[]

  @@index([organizationId])
}

// Entidad legal dueña de propiedades: persona natural o sociedad. Reutilizable
// entre propiedades (una misma entidad participa en varias vía PropertyOwner).
model Owner {
  id             String          @id @default(cuid())
  organizationId String
  nombre         String
  rut            String
  tipo           OwnerType       @default(PERSONA)
  grupoId        String?
  grupo          Grupo?          @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  properties     PropertyOwner[]

  @@index([organizationId])
  @@index([grupoId])
}

// Puente de copropiedad: varios dueños por propiedad, cada uno con su %.
model PropertyOwner {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  ownerId        String
  porcentaje     Decimal  @db.Decimal(5, 2)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerId])
  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// Contratos de arriendo
// ----------------------------------------------------------------------------

model Tenant {
  id             String          @id @default(cuid())
  organizationId String
  nombre         String
  rut            String
  email          String?
  telefono       String?
  contracts      LeaseContract[]

  @@index([organizationId])
}

model LeaseContract {
  id                      String         @id @default(cuid())
  organizationId          String
  propertyId              String
  tenantId                String
  monto                   Decimal        @db.Decimal(14, 2)
  moneda                  Currency       @default(CLP)
  aplicaReajuste          Boolean        @default(false)
  reajusteTipo            AdjustmentType @default(NINGUNO)
  reajusteFrecuenciaMeses Int?
  fechaInicio             DateTime
  fechaTermino            DateTime
  diaPago                 Int
  estado                  ContractStatus @default(VIGENTE)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  charges  RentCharge[]
  alerts   Alert[]

  @@index([organizationId])
  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Control económico
// ----------------------------------------------------------------------------

// Cobro de arriendo por período. El corazón de la cobranza.
model RentCharge {
  id              String       @id @default(cuid())
  organizationId  String
  contractId      String
  periodo         String // "YYYY-MM"
  montoEsperado   Decimal      @db.Decimal(14, 2)
  moneda          Currency     @default(CLP)
  fechaVencimiento DateTime
  estado          ChargeStatus @default(PENDIENTE)
  fechaPago       DateTime?
  montoPagado     Decimal?     @db.Decimal(14, 2)
  interesMora     Decimal?     @db.Decimal(14, 2) // manual en MVP
  notas           String?

  contract  LeaseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  movements Movement[]

  @@unique([contractId, periodo])
  @@index([organizationId])
}

model Movement {
  id             String           @id @default(cuid())
  organizationId String
  propertyId     String
  tipo           MovementType
  categoria      MovementCategory
  monto          Decimal          @db.Decimal(14, 2)
  moneda         Currency         @default(CLP)
  fecha          DateTime
  descripcion    String?
  documentId     String?
  rentChargeId   String?

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  document   Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  rentCharge RentCharge? @relation(fields: [rentChargeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
}

model PropertyTax {
  id              String    @id @default(cuid())
  organizationId  String
  propertyId      String
  anio            Int
  cuota           Int // 1-4
  monto           Decimal?  @db.Decimal(14, 2)
  fechaVencimiento DateTime
  estado          TaxStatus @default(PENDIENTE)
  fechaPago       DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, anio, cuota])
  @@index([organizationId])
}

// Cuenta que el dueño debe pagar por una propiedad (gasto común, luz, agua,
// gas, otro). Las contribuciones siguen aparte en PropertyTax.
model PropertyBill {
  id               String     @id @default(cuid())
  organizationId   String
  propertyId       String
  tipo             BillType
  periodo          String // "YYYY-MM"
  monto            Decimal?   @db.Decimal(14, 2)
  moneda           Currency   @default(CLP)
  fechaVencimiento DateTime
  estado           BillStatus @default(PENDIENTE)
  fechaPago        DateTime?
  notas            String?
  createdAt        DateTime   @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Documental
// ----------------------------------------------------------------------------

// Metadatos + puntero al archivo. El binario vive en Vercel Blob (privado).
// `extractedText`/embeddings (silver/gold) son post-MVP — reservados, no se llenan aún.
model Document {
  id             String       @id @default(cuid())
  organizationId String
  propertyId     String
  tipo           DocumentType
  papel          Papel? // qué papel es (null = documento suelto, sin papel asignado)
  nombre         String
  blobKey        String // puntero al objeto en Vercel Blob
  fechaEmision   DateTime?
  fechaVencimiento DateTime? // alimenta alertas de vencimiento
  // Campos Conservador (opcionales)
  fojas          String?
  numero         String?
  anio           Int?
  // Reservado para IA (post-MVP): texto extraído del PDF/imagen
  extractedText  String?
  createdAt      DateTime     @default(now())

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  movements Movement[]

  @@index([organizationId])
  @@index([propertyId])
}

// ----------------------------------------------------------------------------
// Alertas (autocontrol) y soporte
// ----------------------------------------------------------------------------

model Alert {
  id             String        @id @default(cuid())
  organizationId String
  tipo           AlertType
  severidad      AlertSeverity @default(MEDIA)
  mensaje        String
  propertyId     String?
  contractId     String?
  estado         AlertStatus   @default(ACTIVA)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  property Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contract LeaseContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([estado])
}

// Valores UF/IPC para convertir entre CLP y UF en informes. Global (sin organizationId).
model CurrencyValue {
  id    String   @id @default(cuid())
  fecha DateTime
  tipo  RateType
  valor Decimal  @db.Decimal(14, 4)

  @@unique([fecha, tipo])
}
