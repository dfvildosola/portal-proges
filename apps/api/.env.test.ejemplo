# Base de las pruebas de la API (npm run prueba -w @proges/api). Copia este archivo a
# .env.test y pon tu usuario del Mac. Tiene que terminar en _test: las pruebas se niegan a
# correr sobre otra base. Si no existe, la prueba la crea y le aplica las migraciones.
DATABASE_URL="postgresql://<tu-usuario-del-mac>@localhost:5432/proges_test?schema=public"
